{
  "name": "lastmilepdf",
  "version": "0.2.0",
  "description": "Standalone Electron app for viewing and editing PDF accessibility (tag) structure trees.",
  "main": "main.js",
  "author": "Benjamin Sloan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brsloan/lastmilepdf.git"
  },
  "bugs": {
    "url": "https://github.com/brsloan/lastmilepdf/issues"
  },
  "homepage": "https://github.com/brsloan/lastmilepdf#readme",
  "private": true,
  "scripts": {
    "start": "electron .",
    "typecheck": "node scripts/typecheck.js",
    "test": "node scripts/smoke-test.js",
    "build:worker": ".venv\\Scripts\\python.exe -m PyInstaller --onefile --noconsole --name tag_worker --distpath python-dist --workpath build/pyinstaller --specpath build --collect-all pikepdf python/tag_worker.py",
    "build:worker:linux": ".venv/bin/python -m PyInstaller --onefile --noconsole --name tag_worker --distpath python-dist --workpath build/pyinstaller --specpath build --collect-all pikepdf python/tag_worker.py",
    "dist:win": "npm run build:worker && electron-builder --win --publish never",
    "dist:linux": "npm run build:worker:linux && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^4.6.82",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.bensloan.lastmilepdf",
    "productName": "LastMilePDF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "brsloan",
      "repo": "lastmilepdf"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!renderer/jsconfig.json",
      "node_modules/**/*",
      "!python/**",
      "!python-dist/**",
      "!.venv/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "python-dist/tag_worker.exe",
          "to": "python/tag_worker.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "extraResources": [
        {
          "from": "python-dist/tag_worker",
          "to": "python/tag_worker"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
